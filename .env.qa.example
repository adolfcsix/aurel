# QA ONLY: copy to .env on a dedicated development machine, never deploy.
# Run docker compose --profile qa up -d db-test first.
AUREL_STORAGE=postgres
AUREL_PG_TEST_DATABASE_URL=postgresql://aurelqa:aurel_qa_disposable_only@127.0.0.1:5436/aurel_workspace_test
AUREL_PG_TEST_WRITE_ACK=yes
PG_SSL=false
PORT=4100
# The QA gate starts its own API with a throwaway password.
# Do not point DATABASE_URL at a real company database during QA.
