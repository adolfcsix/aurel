# AUREL local configuration template; copy to .env at repository root. Do not commit .env.
PORT=4100
# Default without AUREL_STORAGE=postgres: sample JSON repository (DEMO only).
# Demo login: admin / AurelDemo@2026 (change locally via DEMO_ADMIN_PASSWORD BEFORE first run).
DEMO_ADMIN_PASSWORD=AurelDemo@2026

# To use PostgreSQL (recommended before storing actual information):
# AUREL_STORAGE=postgres
# DATABASE_URL=postgresql://aurel:aurel_local_only@localhost:5435/aurel
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=ReplaceWithStrongUniquePasswordHere
# COOKIE_SECURE=false
# Payment evidence files reside in backend/data/payment-attachments; back up separately.
# PG_SSL=false
# ALLOW_DEMO_IMPORT=yes

# OPTIONAL QA ONLY — MUST point to an EMPTY disposable database ending in _test:
# AUREL_PG_TEST_DATABASE_URL=postgresql://user:password@localhost:5432/aurel_workspace_test
# AUREL_PG_TEST_WRITE_ACK=yes

# Store payment evidence beside the matching database backups; use an absolute path.
# Leave unset for JSON demo with AUREL_DEMO_DATA_DIR (uses its payment-attachments/ folder).
# AUREL_EVIDENCE_DIR=D:/aurel-secure/payment-attachments
