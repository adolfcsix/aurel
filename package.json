{
  "name": "aurel-estate-workspace",
  "version": "2.86.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:check": "node scripts/dev.mjs --check",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "seed": "node --env-file-if-exists=.env backend/src/seed-command.js",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:test": "node --env-file-if-exists=.env backend/src/migrate.js --test-target",
    "qa:migrations": "node --test backend/tests/v29-migration-integrity.test.js backend/tests/v210-atomic-migrations.test.js backend/tests/v211-sql-statement-boundaries.test.js backend/tests/v212-migration-sequence-integrity.test.js",
    "test": "node --test --test-concurrency=4 backend/tests/*.test.js frontend/tests/*.test.js",
    "db:import-demo": "npm run db:import-demo -w backend",
    "doctor": "npm run doctor -w backend",
    "smoke": "node scripts/smoke.mjs",
    "smoke:pg": "node --env-file-if-exists=.env scripts/smoke.mjs --postgres",
    "pg:verify": "node --env-file-if-exists=.env scripts/verify-pg.mjs",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.mjs",
    "qa:ledger": "node --test backend/tests/v19-ledger-integration.test.js",
    "qa:policies": "node --test backend/tests/v21-default-fee-and-reminders.test.js backend/tests/v21-login-throttle.test.js backend/tests/v21-transaction-continuity.test.js",
    "qa:requirements": "node --test backend/tests/v20-requirements-completion.test.js frontend/tests/v20-requirements-wiring.test.js",
    "qa:deposit": "node --test backend/tests/v22-deposit-acceptance.test.js",
    "qa:gate": "node --env-file-if-exists=.env scripts/qa-gate.mjs",
    "qa:gate:pg": "node --env-file-if-exists=.env scripts/qa-gate.mjs --postgres",
    "qa:integrity": "node --env-file-if-exists=.env scripts/data-integrity.mjs",
    "qa:integrity:demo": "node scripts/data-integrity.mjs --demo-seed",
    "qa:gate:contracts": "node --test backend/tests/v24-integration-gate.test.js",
    "qa:evidence": "node --env-file-if-exists=.env scripts/evidence-integrity.mjs",
    "qa:evidence:demo": "node scripts/evidence-integrity.mjs --demo-seed",
    "qa:access": "node --test backend/tests/v26-privacy-boundaries.test.js backend/tests/v263-api-state-access-integrity.test.js frontend/tests/v26-maker-checker-ux.test.js",
    "qa:evidence:storage": "node --test backend/tests/v27-evidence-storage.test.js",
    "qa:pg:atomic": "node --env-file-if-exists=.env scripts/qa-pg-atomic.mjs",
    "qa:pg:inspect": "node --env-file-if-exists=.env scripts/qa-pg-inspect.mjs",
    "qa:offline": "node scripts/qa-offline.mjs",
    "qa:ui:stability": "node scripts/qa-ui-stability.mjs",
    "qa:ui:dialogs": "node --test frontend/tests/v234-modal-focus.test.js frontend/tests/v235-modal-system.test.js",
    "qa:ui:dossiers": "node --test frontend/tests/v238-essential-dossier-portfolio.test.js frontend/tests/v239-dossier-consistency.test.js",
    "qa:catalog": "node --test frontend/tests/v239-dossier-consistency.test.js frontend/tests/v242-portfolio-continuity.test.js",
    "qa:lease-links": "node --test backend/tests/v243-lease-client-reference.test.js frontend/tests/v243-lease-dossier-link.test.js",
    "qa:source": "node scripts/qa-source-integrity.mjs",
    "qa:browser": "node scripts/qa-react-browser.mjs",
    "qa:browser:driver": "node scripts/qa-react-browser.mjs --driver-check",
    "qa:gate:ui": "node --env-file-if-exists=.env scripts/qa-gate.mjs --browser",
    "smoke:xlsx": "node scripts/smoke.mjs --xlsx",
    "qa:browser:evidence": "node scripts/qa-react-browser.mjs --evidence",
    "qa:release": "npm run qa:source && npm run qa:ui:dialogs && npm run qa:ui:stability",
    "qa:recovery:json": "node scripts/qa-json-recovery.mjs",
    "qa:recovery:pg": "node --env-file-if-exists=.env scripts/qa-pg-recovery.mjs",
    "qa:dom": "node scripts/qa-react-dom.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0"
  }
}
